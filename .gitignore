# Runtime derivatives written by the skin, never source.
rivage/cache/

# Local packaging output.
jsplitter.zip

# Per-user settings shared between panels (UI scale, low-power mode, Rediscover).
# The skin falls back to defaults when these are missing.
rivage/config/

# Working notes stay local; only the README and CHANGELOG are published.
*.md
!/README.md
!/CHANGELOG.md
